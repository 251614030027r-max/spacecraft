+def test_opportunity_bound_is_the_stage_reward_plus_the_discounted_entry_value():
+    """T2.7: L = r1 + gamma G - Phi(s) (PBRS cancels Phi of the stage end), G = the entry-outcome replay of the
+    executor's plan with the time left; no plan, no bound."""
+    from env.t2_stage import ENTRY_CAL_MIN, EntryCalibration, GAMMA_STAGE, T2StageEnv
+    env = T2StageEnv(shaping=True, opportunity=True); env.reset()
+    ecal = EntryCalibration()
+    for k in range(ENTRY_CAL_MIN):
+        ecal.add(30.0, 0.3, 80.0, 0.35, True, 0.0, 150.0)
+    env._opportunity = lambda q, v, t, rot, om: {'tau': 30.0, 'dv_plan': 0.3, 'plan': None}
+    start = {'phi': -7.0}
+    g = ecal.predict(30.0, 0.3, env.env.config.reward, env.mission['deadline_s'] - 40.0)['reward']
+    assert abs(env._opportunity_bound(0, 0, 40.0, 0, 0, -2.5, start, ecal) - (-2.5 + GAMMA_STAGE * g + 7.0)) < 1e-9
+    env._opportunity = lambda *args: None
+    assert env._opportunity_bound(0, 0, 40.0, 0, 0, -2.5, start, ecal) is None
+
