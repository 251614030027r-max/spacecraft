From bfbee9d2a14091ce29bc7ce1df81f05632e5f50f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 13 Sep 2026 01:03:32 +0000
Subject: [PATCH 8/9] fix: record the observation width and the evaluation
 flags in the manifest

The evaluation path loads a checkpoint against the observation it was trained
on and refuses a mismatch, and three of its defaults disagree with how these
runs are trained: --horizon is 20 against 35, --parametrization is radial_local
against arrival_condition, and --phase-time-observation is off while training
sets it on. Getting any of them wrong is a refused load or an incomparable
horizon, discovered only after the training has been spent.

So the manifest now carries observation_dimension, action_dimension and an
evaluation_flags line that can be copied straight into the evaluation command,
rather than leaving the width to be re-derived from flag names.

Also fixes the observation_space description, which listed the 24D core, the
attitude representation and the remaining time but not the ratchet level the
policy is actually given. The manifest is the reproduction record; a
description that omits a dimension misrecords the run.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KfdW4y9TEkhu2Sc1bKnkER
---
 train/train_hybrid.py | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/train/train_hybrid.py b/train/train_hybrid.py
index d345572..0a80bb5 100644
--- a/train/train_hybrid.py
+++ b/train/train_hybrid.py
@@ -156,6 +156,14 @@ def main() -> None:
                 if hybrid_config.include_target_phase_and_time_observation
                 else ""
             )
+            + (
+                ", and the commit ratchet's level in [0, 1], which the policy "
+                "needs because the same action commands a different waypoint "
+                "depending on how far the commit has already advanced"
+                if hybrid_config.monotone_commit
+                and hybrid_config.waypoint_parametrization == "arrival_condition"
+                else ""
+            )
             + (
                 ", and a 3D execution-feedback summary of the previous "
                 "decision (fallback fraction, peak solved-step slack, mean "
@@ -164,6 +172,7 @@ def main() -> None:
                 else ""
             )
         ),
+
         "coupling_direction": (
             "bidirectional: the policy proposes an arrival condition and the "
             "constrained MPC returns how hard that proposal was to execute"
@@ -217,6 +226,22 @@ def main() -> None:
 
     raw_env = PrecaptureHybridEnv(environment_config, hybrid_config)
     raw_env.reset(seed=args.seed)
+    # The evaluation path loads a checkpoint against the observation it was
+    # trained on and refuses a mismatch, so the width belongs in the
+    # reproduction record rather than being re-derived from flag names.
+    manifest["observation_dimension"] = int(
+        raw_env.observation_space.shape[0]
+    )
+    manifest["action_dimension"] = int(raw_env.action_space.shape[0])
+    manifest["evaluation_flags"] = " ".join(
+        [
+            f"--horizon {args.horizon}",
+            f"--parametrization {args.parametrization}",
+        ]
+        + (["--phase-time-observation"] if hybrid_config.include_target_phase_and_time_observation else [])
+        + (["--execution-feedback"] if hybrid_config.include_execution_feedback_observation else [])
+    )
+    manifest_path.write_text(json.dumps(manifest, indent=1, default=str))
     env = Monitor(
         raw_env,
         filename=str(log_dir / "train"),
