+    arrivals before deadline - margin; none when the deadline leaves no arrival; the projection is an action of the grid."""
+    from env.t1_p_stage import relative_inertial
+    from env.t2_stage import BRIDGE_DEADLINE_MARGIN_S, OPPORTUNITY_TAUS_S, T2StageEnv, TRACK_GRID, frame_now
+    env = T2StageEnv(openings=[2910001], seed_base=2_910_000, opportunity=True)
+    env.reset(options={'opening': 2910001}); e = env.env
+    q, v = relative_inertial(e)
+    rot, om = e.target_state.rotation, e.target_state.omega
+    opp = env._opportunity(q, v, e.time_s, rot, om)
+    assert opp is not None and opp['tau'] in OPPORTUNITY_TAUS_S and opp['tau'] <= env.mission['deadline_s'] - BRIDGE_DEADLINE_MARGIN_S
+    assert env._opportunity(q, v, env.mission['deadline_s'] - BRIDGE_DEADLINE_MARGIN_S - 10.0, rot, om) is None
+    start = {'q': q, 'v': v, 'frame': frame_now(e, q), 't': e.time_s, 'rotation': rot, 'omega': om}
+    a = env._track_intent(start)
+    assert a is not None and tuple(float(x) for x in a) in TRACK_GRID
+
