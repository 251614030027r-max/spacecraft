+def test_bound_rows_are_one_sided_and_enter_the_model_loss():
+    """T2.7 learner: a bound row adds w max(0, L - Q)^2 only where the critic values the intent below L; the executed
+    intent's bound (realized stage end) too; readings report the share of bounded and active rows."""
+    import torch as th
+    from env.t2_stage import OBS_DIM
+    m = _sac()
+    for k in range(16):
+        fact = {'reward': -1.0, 'next_obs': np.zeros(OBS_DIM, np.float32), 'done': False, 'bound': 500.0 if k % 2 else None}
+        cands = [{'a': np.full(2, .1, np.float32), 'reward': -1.0, 'next_obs': np.zeros(OBS_DIM, np.float32), 'done': False, 'bound': 1e4},
+                 {'a': np.full(2, -.1, np.float32), 'reward': -1.0, 'next_obs': np.zeros(OBS_DIM, np.float32), 'done': False, 'bound': -1e4},
+                 {'a': np.full(2, .3, np.float32), 'reward': -1.0, 'next_obs': np.zeros(OBS_DIM, np.float32), 'done': False}]
+        m.replay_buffer.add(np.zeros((1, OBS_DIM)), np.zeros((1, OBS_DIM)), np.zeros((1, 2)), np.array([-1.0]), np.array([False]),
+                            [{'model': {'fact': fact, 'cands': cands, 'diag': {'reason': 'stage'}}}])
+    rb = m.replay_buffer
+    assert rb.model_counts['bounds'] == 32 and rb.model_counts['fact_bounds'] == 8
+    data = rb.sample(16)
+    m.td_ms = 1.0
+    mb = rb.model_batch(); k = mb['cand_valid'].shape[1]
+    rows = mb['fact_valid'] > 0; mask = (mb['cand_valid'] > 0) & rows.reshape(-1, 1)
+    out = m._bound_rows(data, mb, mask, rows, th.zeros(16))
+    assert abs(out['bound_share'] - 2 / 3) < 1e-6 and out['rows'] == int(((mb['cand_bound_valid'] > 0) & mask).sum() + (mb['fact_bound_valid'] > 0).sum())
+    assert abs(out['bound_active_share'] - 0.5) < 1e-6          # L = 1e4 binds, L = -1e4 never does
+    assert float(out['loss_sum']) > 0 and 0 < out['fact_bound_share'] < 1
+    m.train(gradient_steps=5, batch_size=8)
+    s = [x for x in m.model_stats if x.get('bound_share') is not None]
+    assert s and all(np.isfinite(x['model_td']) for x in s if x.get('model_td') is not None)
+
