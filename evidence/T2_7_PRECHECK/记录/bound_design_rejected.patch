+    def _bound_rows(self, data, m, mask, rows, err):
+        """T2.7 executor opportunity bounds: Q(s, a) >= L(s, a) = r1 + gamma G - Phi(s), G the value of the executor's
+        earliest feasible entry from the intent's stage end (``T2StageEnv._opportunity_bound``), for the candidates
+        (predicted stage end) and the executed intent (realized stage end). One-sided: a row adds
+        w max(0, L - Q)^2 to the model loss and nothing where the critic already values the intent at least as high.
+        Validity: L <= Q*(s, a) when the plan is realizable by stage intents (sandbox: tracking it captured 19/19 urgent
+        audit missions) and the outcome model is unbiased; the soft Bellman operator followed by max(., L) is still a
+        gamma-contraction with Q* a fixed point (optimality tightening, He et al. 2017). Weight as every model row:
+        eps = |e_a| + b for a candidate (model state + outcome model), eps = b for the executed intent; b the current
+        entry outcome-model bias (one sigma while unknown)."""
+        cb = (m['cand_bound_valid'] > 0) & mask
+        fb = (m['fact_bound_valid'] > 0) & rows
+        if not bool(cb.any()) and not bool(fb.any()):
+            return None
+        b_now = float(np.sqrt(self.td_ms)) if self.entry_bias_now is None else abs(float(self.entry_bias_now))
+        k = mask.shape[1]
+        total, n, gap, act = 0.0, 0, [], []
+        if bool(cb.any()):
+            s = data.observations[:, None, :].expand(-1, k, -1)[cb]
+            lb = m['cand_bound'][cb].reshape(-1, 1)
+            ea = err.abs().reshape(-1, 1).expand(-1, k)[cb].reshape(-1, 1)
+            wb = 1.0 / (1.0 + (ea + b_now) ** 2 / self.td_ms)
+            for q in self.critic(s, m['cand_a'][cb]):
