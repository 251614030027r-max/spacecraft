+def decide_t27(r: dict, mech: dict | None = None, checkpoints=(1000, 2000, 3000, 4000)) -> dict:
+    """T2.7 executor opportunity supervision (pre-registered with its run order): EACC with the opportunity bounds (seeds 0
+    and 1 from zero, 4000 decisions) against the T2.6W SAC (reused: the task is T2.6W's and the SAC arm never computes a
+    label), checkpoints 1000..4000 on the 48 development openings, urgent deadlines U(140, 200) s.
+
+      C0, E1, U, E2, S   as t26w over the checkpoints (unchanged thresholds)
+      M  mechanism       both EACC runs, probes from 1000 on: bound_share >= 0.05 (bounds exist), bound_active_share > 0
+                         (they move the critic somewhere), w_mean >= 0.5 (not weighted away)
+    Reported as t26w."""
+    stub = {k: {'two_stage_share': 1.0, 'decisive_share': 1.0, 'w2_mean': 1.0, 'pi_gap_sigma_median': 0.0, 'grad_cos': 1.0}
+            for k in (mech or {'none': None})}
+    out = decide_t26w(r, stub if mech else {}, checkpoints)
+    if out['verdict'] == 'incomplete':
+        return out
+    c, v = out['criteria'], out['values']
+    mech = mech or {}
+    v['mechanism'] = mech
+    c['M_mechanism'] = bool(mech) and all((x.get('bound_share') or 0) >= 0.05 and (x.get('bound_active_share') or 0) > 0
+                                          and (x.get('w_mean') or 0) >= 0.5 for x in mech.values())
+    pos = [v['paired_auc'][s] > 0 for s in ('0', '1')]
+    if not c['M_mechanism']:
+        out['verdict'] = 'mechanism_failure'
+    elif not (c['E2_final'] and c['S_safety']):
+        out['verdict'] = 'harmful'
+    elif c['E1_efficiency'] and c['U_urgent']:
+        out['verdict'] = 'pass'
+    elif all(pos) or (c['U_urgent'] and any(pos)):
+        out['verdict'] = 'partial'
+    else:
+        out['verdict'] = 'no_gain'
+    return out
+
