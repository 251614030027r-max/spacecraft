From a3bd3782e1bb80f8ce34a199d4c76527afd97479 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 12 Sep 2026 21:13:12 +0000
Subject: [PATCH 1/3] tool: record the zero-wrench streak in the scripted-upper
 runs

qp_infeasible_steps alone cannot separate the old absorbing failure -- hundreds
of consecutive zero-wrench steps, episode dies -- from a transient refusal the
controller recovers from. max_consecutive_zero_wrench_steps is that
discriminator, diagnose_terminal_gate already recorded it, and this script did
not.

Its absence cost a stop-and-report cycle: the lower window met a single episode
with 69 infeasible steps out of 3000 and had nothing in the record to tell
whether the controller had been abandoned, so it stopped, correctly, on the
strict reading of gate A.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KfdW4y9TEkhu2Sc1bKnkER
---
 experiments/evaluate_arrival_condition_script.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/experiments/evaluate_arrival_condition_script.py b/experiments/evaluate_arrival_condition_script.py
index 19a6906..18654bd 100644
--- a/experiments/evaluate_arrival_condition_script.py
+++ b/experiments/evaluate_arrival_condition_script.py
@@ -83,6 +83,8 @@ def run_episode(
     _, info = env.reset(seed=seed)
     infeasible_steps = 0
     first_infeasible_time_s: float | None = None
+    consecutive_zero = 0
+    max_consecutive_zero = 0
     force_impulse = 0.0
     torque_impulse = 0.0
     steps = 0
@@ -111,6 +113,11 @@ def run_episode(
                 infeasible_steps += 1
                 if first_infeasible_time_s is None:
                     first_infeasible_time_s = round(float(env.env.time_seconds), 1)
+            if np.count_nonzero(wrench) == 0:
+                consecutive_zero += 1
+                max_consecutive_zero = max(max_consecutive_zero, consecutive_zero)
+            else:
+                consecutive_zero = 0
             force_impulse += (
                 float(np.linalg.norm(wrench[3:])) * env.environment_config.dt_s
             )
@@ -140,6 +147,7 @@ def run_episode(
         "steps": steps,
         "qp_infeasible_steps": infeasible_steps,
         "first_infeasible_time_s": first_infeasible_time_s,
+        "max_consecutive_zero_wrench_steps": max_consecutive_zero,
         "force_impulse_n_s": round(force_impulse, 3),
         "torque_impulse_nm_s": round(torque_impulse, 4),
         "illegal_terminal_entry_count": int(info["illegal_terminal_entry_count"]),
